{
  "name": "fintrack-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "npm run build",
    "dev": "tsc-watch --onSuccess \"node dist/main.js\"",
    "start:dev": "npm run dev",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:config": "docker compose --env-file .env config --quiet",
    "db:up": "docker compose --env-file .env up -d --wait database",
    "db:down": "docker compose --env-file .env down",
    "db:status": "docker compose --env-file .env ps",
    "db:logs": "docker compose --env-file .env logs --tail=100 database",
    "db:migrate": "npm run build && node dist/database/migrate.js",
    "db:seed": "npm run build && node dist/database/seeds/development.js",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.cjs",
    "benchmark:dashboard": "npm run build && node scripts/benchmark-dashboard.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "dotenv": "^18.0.8",
    "luxon": "3.7.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@types/luxon": "3.7.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^10.13.0",
    "tsc-watch": "^7.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
