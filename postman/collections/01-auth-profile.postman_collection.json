  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('baseUrl')) {",
          "  console.error('Selecciona el entorno FinTrack - Local o FinTrack - Render.');",
          "  pm.execution.skipRequest();",
          "} else {",
          "  const now = new Date();",
          "  const parts = new Intl.DateTimeFormat('en-CA', {timeZone: 'America/La_Paz', year: 'numeric', month: '2-digit', day: '2-digit'}).formatToParts(now);",
          "  const date = Object.fromEntries(parts.map(p => [p.type, p.value]));",
          "  const month = date.year + '-' + date.month;",
          "  const today = month + '-' + date.day;",
          "  const defaults = {month: month, reportFrom: month + '-01', reportTo: today, transactionFrom: month + '-01T00:00:00-04:00', transactionTo: now.toISOString()};",
          "  Object.keys(defaults).forEach(key => { if (!pm.variables.get(key)) pm.variables.set(key, defaults[key]); });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "displayName",
      "value": "Usuario Postman"
    },
    {
