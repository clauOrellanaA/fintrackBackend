{
  "openapi": "3.1.0",
  "info": {"title": "FinanTrack dashboard", "version": "1.0.0", "description": "BE-00 approved 2026-10-18; BE-01 through BE-06 implemented. BE-07 validates examples and live HTTP responses against this contract."},
  "servers": [{"url": "http://localhost:3000/api/v1"}],
  "security": [{"bearerSession": []}],
  "paths": {
    "/dashboard": {
      "get": {
        "operationId": "getDashboard",
        "description": "Reject unknown or repeated query parameters. Identity comes exclusively from bearer session. No partial responses.",
        "parameters": [{"name": "month", "in": "query", "required": false, "schema": {"type": "string", "pattern": "^(19[0-9]{2}|[2-8][0-9]{3}|9[0-8][0-9]{2}|99[0-8][0-9]|999[0-8])-(0[1-9]|1[0-2])$"}, "description": "1900-01 through 9998-12; default current product month."}],
        "responses": {
          "200": {"description": "Current implemented sections and explicit unavailable sections.", "headers": {"Cache-Control": {"schema": {"type": "string", "const": "no-store"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Dashboard"}, "examples": {"be06": {"summary":"BE-06: all sections ready; archived reservation 40.00 stays reserved outside visible list. IDs illustrative.","value":{"period":{"month":"2026-02","timeZone":"America/La_Paz","start":"2026-02-01T04:00:00.000Z","endExclusive":"2026-03-01T04:00:00.000Z"},"currency":"BOB","asOf":"2026-10-19T12:00:00.000Z","sections":{"balance":{"status":"ready","data":{"amount":"2200.05","cutoff":"2026-10-19T12:00:00.000Z"}},"monthlySummary":{"status":"ready","data":{"income":"280.01","expense":"280.01"}},"expenseDistribution":{"status":"ready","data":[{"categoryId":"33333333-3333-4333-8333-333333333333","categoryName":"Demo presupuesto excedido","amount":"100.01","percentage":"35.72"},{"categoryId":"22222222-2222-4222-8222-222222222222","categoryName":"Demo presupuesto 100%","amount":"100.00","percentage":"35.71"},{"categoryId":"11111111-1111-4111-8111-111111111111","categoryName":"Demo presupuesto 80%","amount":"80.00","percentage":"28.57"}]},"budgets":{"status":"ready","data":[{"id":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa","categoryId":"11111111-1111-4111-8111-111111111111","categoryName":"Demo presupuesto 80%","limit":"100.00","spent":"80.00","remaining":"20.00","progress":"80.00","state":"warning"},{"id":"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb","categoryId":"22222222-2222-4222-8222-222222222222","categoryName":"Demo presupuesto 100%","limit":"100.00","spent":"100.00","remaining":"0.00","progress":"100.00","state":"warning"},{"id":"cccccccc-cccc-4ccc-8ccc-cccccccccccc","categoryId":"33333333-3333-4333-8333-333333333333","categoryName":"Demo presupuesto excedido","limit":"100.00","spent":"100.01","remaining":"-0.01","progress":"100.01","state":"exceeded"}]},"savingsGoals":{"status":"ready","data":[{"id":"00000000-0000-4000-8000-000000000001","name":"Demo sin aportes","target":"100.00","saved":"0.00","remaining":"100.00","progress":"0.00","state":"active","targetDate":null},{"id":"00000000-0000-4000-8000-000000000002","name":"Demo parcial","target":"100.00","saved":"30.00","remaining":"70.00","progress":"30.00","state":"active","targetDate":"2099-12-31"},{"id":"00000000-0000-4000-8000-000000000003","name":"Demo completada","target":"100.00","saved":"100.00","remaining":"0.00","progress":"100.00","state":"completed","targetDate":"2026-01-31"},{"id":"00000000-0000-4000-8000-000000000004","name":"Demo excedida","target":"100.00","saved":"110.00","remaining":"0.00","progress":"110.00","state":"completed","targetDate":null},{"id":"00000000-0000-4000-8000-000000000005","name":"Demo vencida","target":"100.00","saved":"20.00","remaining":"80.00","progress":"20.00","state":"overdue","targetDate":"2026-01-31"}]}}}}, "be05": {"value":{"period":{"month":"2026-02","timeZone":"America/La_Paz","start":"2026-02-01T04:00:00.000Z","endExclusive":"2026-03-01T04:00:00.000Z"},"currency":"BOB","asOf":"2026-10-19T12:00:00.000Z","sections":{"balance":{"status":"ready","data":{"amount":"2500.05","cutoff":"2026-10-19T12:00:00.000Z"}},"monthlySummary":{"status":"ready","data":{"income":"280.01","expense":"280.01"}},"expenseDistribution":{"status":"ready","data":[{"categoryId":"33333333-3333-4333-8333-333333333333","categoryName":"Demo presupuesto excedido","amount":"100.01","percentage":"35.72"},{"categoryId":"22222222-2222-4222-8222-222222222222","categoryName":"Demo presupuesto 100%","amount":"100.00","percentage":"35.71"},{"categoryId":"11111111-1111-4111-8111-111111111111","categoryName":"Demo presupuesto 80%","amount":"80.00","percentage":"28.57"}]},"budgets":{"status":"ready","data":[{"id":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa","categoryId":"11111111-1111-4111-8111-111111111111","categoryName":"Demo presupuesto 80%","limit":"100.00","spent":"80.00","remaining":"20.00","progress":"80.00","state":"warning"},{"id":"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb","categoryId":"22222222-2222-4222-8222-222222222222","categoryName":"Demo presupuesto 100%","limit":"100.00","spent":"100.00","remaining":"0.00","progress":"100.00","state":"warning"},{"id":"cccccccc-cccc-4ccc-8ccc-cccccccccccc","categoryId":"33333333-3333-4333-8333-333333333333","categoryName":"Demo presupuesto excedido","limit":"100.00","spent":"100.01","remaining":"-0.01","progress":"100.01","state":"exceeded"}]},"savingsGoals":{"status":"notAvailable"}}}}, "be04": {"value":{"period":{"month":"2026-10","timeZone":"America/La_Paz","start":"2026-10-01T04:00:00.000Z","endExclusive":"2026-11-01T04:00:00.000Z"},"currency":"BOB","asOf":"2026-10-19T12:00:00.000Z","sections":{"balance":{"status":"ready","data":{"amount":"2500.05","cutoff":"2026-10-19T12:00:00.000Z"}},"monthlySummary":{"status":"ready","data":{"income":"0.00","expense":"500.05"}},"expenseDistribution":{"status":"ready","data":[{"categoryId":"11111111-1111-4111-8111-111111111111","categoryName":"Alimentacion","amount":"500.05","percentage":"100.00"}]},"budgets":{"status":"notAvailable"},"savingsGoals":{"status":"notAvailable"}}}}, "be03": {"value":{"period":{"month":"2026-10","timeZone":"America/La_Paz","start":"2026-10-01T04:00:00.000Z","endExclusive":"2026-11-01T04:00:00.000Z"},"currency":"BOB","asOf":"2026-10-19T12:00:00.000Z","sections":{"balance":{"status":"ready","data":{"amount":"2500.05","cutoff":"2026-10-19T12:00:00.000Z"}},"monthlySummary":{"status":"ready","data":{"income":"0.00","expense":"500.05"}},"expenseDistribution":{"status":"notAvailable"},"budgets":{"status":"notAvailable"},"savingsGoals":{"status":"notAvailable"}}}}, "be02": {"value":{"period":{"month":"2026-10","timeZone":"America/La_Paz","start":"2026-10-01T04:00:00.000Z","endExclusive":"2026-11-01T04:00:00.000Z"},"currency":"BOB","asOf":"2026-10-19T12:00:00.000Z","sections":{"balance":{"status":"ready","data":{"amount":"2500.05","cutoff":"2026-10-19T12:00:00.000Z"}},"monthlySummary":{"status":"notAvailable"},"expenseDistribution":{"status":"notAvailable"},"budgets":{"status":"notAvailable"},"savingsGoals":{"status":"notAvailable"}}}}, "be01": {"value": {"period": {"month": "2026-10", "timeZone": "America/La_Paz", "start": "2026-10-01T04:00:00.000Z", "endExclusive": "2026-11-01T04:00:00.000Z"}, "currency": "BOB", "asOf": "2026-10-18T12:00:00.000Z", "sections": {"balance": {"status": "notAvailable"}, "monthlySummary": {"status": "notAvailable"}, "expenseDistribution": {"status": "notAvailable"}, "budgets": {"status": "notAvailable"}, "savingsGoals": {"status": "notAvailable"}}}}}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "422": {"$ref": "#/components/responses/OutOfRange"},
          "500": {"$ref": "#/components/responses/InternalError"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/auth/login": {"post": {"operationId": "login", "security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["email", "password"], "properties": {"email": {"type": "string", "format": "email", "maxLength": 254}, "password": {"type": "string", "minLength": 1, "maxLength": 1024}}}}}}, "responses": {"200": {"description": "Session token; never log or store persistently in browser.", "headers": {"Cache-Control": {"schema": {"type": "string", "const": "no-store"}}}, "content": {"application/json": {"schema": {"type": "object", "required": ["accessToken", "tokenType", "expiresAt"], "properties": {"accessToken": {"type": "string"}, "tokenType": {"const": "Bearer"}, "expiresAt": {"type": "string", "format": "date-time"}}}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/auth/session": {"delete": {"operationId": "logout", "responses": {"204": {"description": "Session revoked."}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/Unavailable"}}}}
  },
  "components": {
    "securitySchemes": {"bearerSession": {"type": "http", "scheme": "bearer", "description": "Opaque 256-bit session token, absolute TTL 8h."}},
    "responses": {
      "BadRequest": {"description": "INVALID_PERIOD or INVALID_REQUEST", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Unauthorized": {"description": "UNAUTHENTICATED or INVALID_CREDENTIALS", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "OutOfRange": {"description": "DATA_OUT_OF_RANGE", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "InternalError": {"description": "INTERNAL_ERROR or DATA_INTEGRITY_ERROR", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Unavailable": {"description": "DATA_UNAVAILABLE; no synthetic zero values", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    },
    "schemas": {
      "Money": {"type": "string", "pattern": "^-?(0|[1-9][0-9]{0,11})\\.[0-9]{2}$", "description": "Exact BOB decimal, abs <=999999999999.99; canonical zero 0.00."},
      "Percent": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$", "description": "HALF_UP rounded percentage; may exceed 100.00."},
      "UnavailableSection": {"type": "object", "required": ["status"], "properties": {"status": {"const": "notAvailable"}}},
      "Period": {"type": "object", "required": ["month", "timeZone", "start", "endExclusive"], "properties": {"month": {"type": "string"}, "timeZone": {"const": "America/La_Paz"}, "start": {"type": "string", "format": "date-time"}, "endExclusive": {"type": "string", "format": "date-time"}}},
      "Balance": {"type": "object", "required": ["amount", "cutoff"], "properties": {"amount": {"$ref": "#/components/schemas/Money"}, "cutoff": {"type": "string", "format": "date-time"}}},
      "MonthlySummary": {"type": "object", "description": "Gross posted income and expense for the selected half-open IANA month. Includes future effective dates within that month; independent of balance asOf. Successful empty period returns 0.00 each.", "required": ["income", "expense"], "properties": {"income": {"$ref": "#/components/schemas/Money"}, "expense": {"$ref": "#/components/schemas/Money"}}},
      "CategoryExpense": {"type": "object", "description": "Monthly gross posted expense grouped by owned category; null is Sin categoria. Sorted amount descending then categoryId ascending, null last on ties. Percentages use independent HALF_UP; sum may differ from 100 by at most 0.005 percentage points per category. Empty expense month returns an empty list.", "required": ["categoryId", "categoryName", "amount", "percentage"], "properties": {"categoryId": {"type": ["string", "null"], "format": "uuid"}, "categoryName": {"type": "string"}, "amount": {"$ref": "#/components/schemas/Money"}, "percentage": {"$ref": "#/components/schemas/Percent"}}},
      "Budget": {"type": "object", "description": "Positive category budget for selected month, without rollover. Gross posted category expense is spent; remaining may be negative; HALF_UP progress may exceed100. State uses exact amounts before rounding: normal<80%, warning80..100% inclusive, exceeded>100%. No budgets returns empty list; no spending on an existing budget returns valid zero/normal.", "required": ["id", "categoryId", "categoryName", "limit", "spent", "remaining", "progress", "state"], "properties": {"id": {"type": "string", "format": "uuid"}, "categoryId": {"type": "string", "format": "uuid"}, "categoryName": {"type": "string"}, "limit": {"$ref": "#/components/schemas/Money"}, "spent": {"$ref": "#/components/schemas/Money"}, "remaining": {"$ref": "#/components/schemas/Money"}, "progress": {"$ref": "#/components/schemas/Percent"}, "state": {"enum": ["normal", "warning", "exceeded"]}}},
      "SavingsGoal": {"type": "object", "required": ["id", "name", "target", "saved", "remaining", "progress", "state", "targetDate"], "properties": {"id": {"type": "string", "format": "uuid"}, "name": {"type": "string"}, "target": {"$ref": "#/components/schemas/Money"}, "saved": {"$ref": "#/components/schemas/Money"}, "remaining": {"$ref": "#/components/schemas/Money"}, "progress": {"$ref": "#/components/schemas/Percent"}, "state": {"enum": ["active", "completed", "overdue"]}, "targetDate": {"type": ["string", "null"], "format": "date"}}},
      "Dashboard": {"type": "object", "required": ["period", "currency", "asOf", "sections"], "properties": {"period": {"$ref": "#/components/schemas/Period"}, "currency": {"const": "BOB"}, "asOf": {"type": "string", "format": "date-time"}, "sections": {"type": "object", "required": ["balance", "monthlySummary", "expenseDistribution", "budgets", "savingsGoals"], "properties": {
        "balance": {"oneOf": [{"$ref": "#/components/schemas/UnavailableSection"}, {"type": "object", "required": ["status", "data"], "properties": {"status": {"const": "ready"}, "data": {"$ref": "#/components/schemas/Balance"}}}]},
        "monthlySummary": {"oneOf": [{"$ref": "#/components/schemas/UnavailableSection"}, {"type": "object", "required": ["status", "data"], "properties": {"status": {"const": "ready"}, "data": {"$ref": "#/components/schemas/MonthlySummary"}}}]},
        "expenseDistribution": {"oneOf": [{"$ref": "#/components/schemas/UnavailableSection"}, {"type": "object", "required": ["status", "data"], "properties": {"status": {"const": "ready"}, "data": {"type": "array", "items": {"$ref": "#/components/schemas/CategoryExpense"}}}}]},
        "budgets": {"oneOf": [{"$ref": "#/components/schemas/UnavailableSection"}, {"type": "object", "required": ["status", "data"], "properties": {"status": {"const": "ready"}, "data": {"type": "array", "items": {"$ref": "#/components/schemas/Budget"}}}}]},
        "savingsGoals": {"oneOf": [{"$ref": "#/components/schemas/UnavailableSection"}, {"type": "object", "required": ["status", "data"], "properties": {"status": {"const": "ready"}, "data": {"type": "array", "items": {"$ref": "#/components/schemas/SavingsGoal"}}}}]}
      }}}},
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}}
    }
  }
}
