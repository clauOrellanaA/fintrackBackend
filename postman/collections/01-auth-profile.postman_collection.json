                  "pm.test('JSON válido', function () {pm.response.json();});",
                  "pm.test('Servicio FinTrack activo', function () {const body = pm.response.json(); pm.expect(body.status).to.equal('ok'); pm.expect(body.service).to.equal('fintrack-api');});"
