    {
      "name": "04 Diagnóstico",
      "item": [
        {
          "name": "Comprobar servicio",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const required = [];",
                  "const missing = required.filter(key => {const value = pm.variables.get(key); return typeof value !== 'string' || value.trim() === '' || value.includes('{{');});",
                  "if (missing.length) {console.error('Completa las variables locales del entorno: ' + missing.join(', ')); pm.execution.skipRequest();}"
                ]
