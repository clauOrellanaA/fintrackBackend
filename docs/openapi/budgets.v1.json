{
  "openapi": "3.1.0",
  "info": {
    "title": "FinanTrack budgets",
    "version": "1.0.0",
    "description": "Authenticated monthly budget management. A budget belongs to one category, user, and month; identity is resolved from the session."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1"
    }
  ],
  "security": [
    {
      "bearerSession": []
    }
  ],
  "paths": {
    "/budgets": {
      "get": {
        "operationId": "listBudgets",
        "description": "Returns the authenticated user's budgets for a month, including exact expense consumption from posted movements. Defaults to the current product month.",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Budgets for the selected month; empty when none exist.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Budget"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "post": {
        "operationId": "createBudget",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBudget"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created budget with current monthly consumption.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Budget"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/OutOfRange"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/budgets/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "patch": {
        "operationId": "updateBudget",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBudget"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated budget with current monthly consumption.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Budget"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/OutOfRange"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "delete": {
        "operationId": "deleteBudget",
        "responses": {
          "204": {
            "description": "Budget deleted."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Session required or invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Budget or category not found for this user.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "A budget already exists for that user, category, and month.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "OutOfRange": {
        "description": "Budget limit is outside the supported exact decimal range.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Storage is unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Money": {
        "type": "string",
        "pattern": "^-?\\d{1,12}\\.\\d{2}$"
      },
      "Percent": {
        "type": "string",
        "pattern": "^\\d+\\.\\d{2}$"
      },
      "Budget": {
        "type": "object",
        "required": [
          "id",
          "categoryId",
          "categoryName",
          "limit",
          "spent",
          "remaining",
          "progress",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "categoryName": {
            "type": "string"
          },
          "limit": {
            "$ref": "#/components/schemas/Money"
          },
          "spent": {
            "$ref": "#/components/schemas/Money"
          },
          "remaining": {
            "$ref": "#/components/schemas/Money"
          },
          "progress": {
            "$ref": "#/components/schemas/Percent"
          },
          "state": {
            "type": "string",
            "enum": [
              "normal",
              "warning",
              "exceeded"
            ]
          }
        },
        "additionalProperties": false
      },
      "CreateBudget": {
        "type": "object",
        "required": [
          "categoryId",
          "month",
          "limit"
        ],
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "limit": {
            "$ref": "#/components/schemas/PositiveMoney"
          }
        },
        "additionalProperties": false
      },
      "UpdateBudget": {
        "type": "object",
        "required": [
          "limit"
        ],
        "properties": {
          "limit": {
            "$ref": "#/components/schemas/PositiveMoney"
          }
        },
        "additionalProperties": false
      },
      "PositiveMoney": {
        "type": "string",
        "pattern": "^(?:0|[1-9]\\d{0,11})\\.\\d{2}$",
        "description": "The exact value must be greater than zero."
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
