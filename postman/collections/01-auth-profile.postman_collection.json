            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP 204', function () {pm.response.to.have.status(204);});",
                  "pm.test('Respuesta sin contenido', function () {pm.expect(pm.response.text()).to.equal('');});",
                  "pm.test('Respuesta privada sin caché', function () {pm.response.to.have.header('Cache-Control', 'no-store');});",
